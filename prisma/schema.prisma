// Schema do banco (Supabase Postgres). URLs de conexão ficam em prisma.config.ts.
//
// Segurança: as tabelas ficam no schema `public`, que o Supabase expõe na Data API.
// A migração `rls_enable` habilita RLS sem políticas e revoga os grants de
// anon/authenticated, de modo que só a aplicação (role postgres via Prisma) acessa os dados.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Pessoas
// ---------------------------------------------------------------------------

/// Terapeuta que acessa o /admin. `authUserId` é o id em auth.users (Supabase Auth).
/// O registro é criado por upsert no primeiro login.
model Terapeuta {
  id         String   @id @default(uuid()) @db.Uuid
  authUserId String   @unique @map("auth_user_id") @db.Uuid
  nome       String
  email      String   @unique
  unidade    String?
  ativo      Boolean  @default(true)
  criadoEm   DateTime @default(now()) @map("criado_em")

  revisoesMassoterapia FichaMassoterapia[] @relation("MassoterapiaRevisora")
  revisoesHeadSpa      FichaHeadSpa[]      @relation("HeadSpaRevisora")
  revisoesDepilacao    FichaDepilacao[]    @relation("DepilacaoRevisora")

  @@map("terapeutas")
}

/// Cliente atendida. Identificada pelo telefone normalizado (só dígitos).
/// Pode ter várias fichas do mesmo tipo (histórico de envios).
model Paciente {
  id             String    @id @default(uuid()) @db.Uuid
  nome           String
  telefone       String    @unique
  email          String?
  dataNascimento DateTime? @map("data_nascimento") @db.Date
  criadoEm       DateTime  @default(now()) @map("criado_em")
  atualizadoEm   DateTime  @updatedAt @map("atualizado_em")

  fichasMassoterapia FichaMassoterapia[]
  fichasHeadSpa      FichaHeadSpa[]
  fichasDepilacao    FichaDepilacao[]

  @@map("pacientes")
}

// ---------------------------------------------------------------------------
// Fichas (uma tabela por tipo, colunas fixas)
// ---------------------------------------------------------------------------

enum TipoFicha {
  MASSOTERAPIA
  HEAD_SPA
  DEPILACAO
}

enum FichaStatus {
  ENVIADA
  REVISADA
}

enum ObjetivoMassagem {
  RELAXAMENTO
  REDUCAO_ESTRESSE
  ALIVIO_DORES
  RELAXAMENTO_MUSCULAR
  BEM_ESTAR
  OUTRO
}

enum PressaoArterial {
  NAO
  SIM
  NAO_SEI
}

enum ProdutoMassagem {
  OLEO
  CREME
  SEM_PREFERENCIA
}

enum PressaoMassagem {
  LEVE
  MODERADA
  FORTE
}

enum ObjetivoHeadSpa {
  RELAXAMENTO
  REDUCAO_ESTRESSE
  HIGIENIZACAO_PROFUNDA
  CONTROLE_OLEOSIDADE
  ALIVIO_SENSIBILIDADE
  QUEDA_CAPILAR
  OUTRO
}

enum TipoCabelo {
  LISO
  ONDULADO
  CACHEADO
  CRESPO
}

enum IntensidadeMassagem {
  SUAVE
  MODERADA
  FORTE
}

enum AreaDepilacao {
  BUCO
  ROSTO
  AXILAS
  BRACOS
  PERNAS
  VIRILHA
  INTIMA_COMPLETA
  COSTAS
  ABDOMEN
  OUTRA
}

enum MetodoDepilacao {
  CERA_QUENTE
  CERA_FRIA
  LAMINA
  CREME_DEPILATORIO
  LINHA
  LASER
}

/// Anamnese de Massoterapia. Perguntas oficiais da ficha em papel (2026-09-21).
model FichaMassoterapia {
  id           String      @id @default(uuid()) @db.Uuid
  status       FichaStatus @default(ENVIADA)
  enviadaEm    DateTime    @default(now()) @map("enviada_em")
  atualizadaEm DateTime    @updatedAt @map("atualizada_em")

  pacienteId    String  @map("paciente_id") @db.Uuid
  revisadaPorId String? @map("revisada_por_id") @db.Uuid

  aceitaTermos Boolean @map("aceita_termos")
  aceitaImagem Boolean @default(false) @map("aceita_imagem")

  // 2. objetivo do atendimento
  objetivos     ObjetivoMassagem[]
  objetivoOutro String?            @map("objetivo_outro")
  regiaoAtencao String?            @map("regiao_atencao")

  // 3. condições de saúde
  problemaCardiaco         Boolean         @default(false) @map("problema_cardiaco")
  problemaCardiacoQual     String?         @map("problema_cardiaco_qual")
  problemaRespiratorio     Boolean         @default(false) @map("problema_respiratorio")
  problemaRespiratorioQual String?         @map("problema_respiratorio_qual")
  problemaColuna           Boolean         @default(false) @map("problema_coluna")
  problemaColunaQual       String?         @map("problema_coluna_qual")
  problemaMuscular         Boolean         @default(false) @map("problema_muscular")
  problemaMuscularQual     String?         @map("problema_muscular_qual")
  problemaPele             Boolean         @default(false) @map("problema_pele")
  problemaPeleQual         String?         @map("problema_pele_qual")
  pressaoArterial          PressaoArterial @map("pressao_arterial")
  medicamentoContinuo      Boolean         @default(false) @map("medicamento_continuo")
  medicamentoQuais         String?         @map("medicamento_quais")
  alergiaProdutos          Boolean         @default(false) @map("alergia_produtos")
  alergiaProdutosQual      String?         @map("alergia_produtos_qual")
  gestante                 Boolean         @default(false)
  gestanteSemanas          String?         @map("gestante_semanas")
  outraCondicao            String?         @map("outra_condicao")

  // 4. preferências para a massagem
  produto             ProdutoMassagem
  pressao             PressaoMassagem
  regiaoEvitar        String?         @map("regiao_evitar")
  jaFezMassagem       Boolean         @default(false) @map("ja_fez_massagem")
  experienciaAnterior String?         @map("experiencia_anterior")
  naoGostou           String?         @map("nao_gostou")
  preferencias        String?

  observacoesTerapeuta String? @map("observacoes_terapeuta")

  paciente    Paciente   @relation(fields: [pacienteId], references: [id])
  revisadaPor Terapeuta? @relation("MassoterapiaRevisora", fields: [revisadaPorId], references: [id])

  @@index([status, enviadaEm])
  @@index([pacienteId])
  @@map("fichas_massoterapia")
}

/// Anamnese de Head Spa. Perguntas oficiais da ficha em papel (2026-09-21).
model FichaHeadSpa {
  id           String      @id @default(uuid()) @db.Uuid
  status       FichaStatus @default(ENVIADA)
  enviadaEm    DateTime    @default(now()) @map("enviada_em")
  atualizadaEm DateTime    @updatedAt @map("atualizada_em")

  pacienteId    String  @map("paciente_id") @db.Uuid
  revisadaPorId String? @map("revisada_por_id") @db.Uuid

  aceitaTermos Boolean @map("aceita_termos")
  aceitaImagem Boolean @default(false) @map("aceita_imagem")

  // 2. objetivo do atendimento
  objetivos     ObjetivoHeadSpa[]
  objetivoOutro String?           @map("objetivo_outro")

  // 3. histórico capilar
  couroSensivel         Boolean @default(false) @map("couro_sensivel")
  coceira               Boolean @default(false)
  descamacaoCaspa       Boolean @default(false) @map("descamacao_caspa")
  oleosidadeExcessiva   Boolean @default(false) @map("oleosidade_excessiva")
  feridasLesoes         Boolean @default(false) @map("feridas_lesoes")
  vermelhidaoIrritacao  Boolean @default(false) @map("vermelhidao_irritacao")
  dorSensibilidadeToque Boolean @default(false) @map("dor_sensibilidade_toque")
  quedaIntensa          Boolean @default(false) @map("queda_intensa")
  doencaCouro           Boolean @default(false) @map("doenca_couro")
  doencaCouroQual       String? @map("doenca_couro_qual")

  // 4. informações de saúde
  alergia             Boolean @default(false)
  alergiaQual         String? @map("alergia_qual")
  gestante            Boolean @default(false)
  problemaCardiaco    Boolean @default(false) @map("problema_cardiaco")
  medicamentoContinuo Boolean @default(false) @map("medicamento_continuo")
  medicamentoQual     String? @map("medicamento_qual")

  // 5. características dos cabelos
  tipoCabelo       TipoCabelo @map("tipo_cabelo")
  quimicaColoracao Boolean    @default(false) @map("quimica_coloracao")
  quimicaQual      String?    @map("quimica_qual")

  // 6. preferência de massagem capilar
  intensidadeMassagem IntensidadeMassagem @map("intensidade_massagem")

  observacoes String?

  observacoesTerapeuta String? @map("observacoes_terapeuta")

  paciente    Paciente   @relation(fields: [pacienteId], references: [id])
  revisadaPor Terapeuta? @relation("HeadSpaRevisora", fields: [revisadaPorId], references: [id])

  @@index([status, enviadaEm])
  @@index([pacienteId])
  @@map("fichas_head_spa")
}

/// Anamnese de Depilação. Perguntas oficiais da ficha em papel (2026-09-21).
model FichaDepilacao {
  id           String      @id @default(uuid()) @db.Uuid
  status       FichaStatus @default(ENVIADA)
  enviadaEm    DateTime    @default(now()) @map("enviada_em")
  atualizadaEm DateTime    @updatedAt @map("atualizada_em")

  pacienteId    String  @map("paciente_id") @db.Uuid
  revisadaPorId String? @map("revisada_por_id") @db.Uuid

  aceitaTermos Boolean @map("aceita_termos")
  aceitaImagem Boolean @default(false) @map("aceita_imagem")

  // 2. área a ser depilada
  areas     AreaDepilacao[]
  areaOutra String?         @map("area_outra")

  // 3. histórico da pele
  peleSensivel         Boolean @default(false) @map("pele_sensivel")
  alergiaCosmetico     Boolean @default(false) @map("alergia_cosmetico")
  alergiaCosmeticoQual String? @map("alergia_cosmetico_qual")
  doencaPele           Boolean @default(false) @map("doenca_pele")
  doencaPeleQual       String? @map("doenca_pele_qual")
  feridasCortes        Boolean @default(false) @map("feridas_cortes")
  irritacaoVermelhidao Boolean @default(false) @map("irritacao_vermelhidao")
  foliculiteEncravados Boolean @default(false) @map("foliculite_encravados")
  manchasSensibilidade Boolean @default(false) @map("manchas_sensibilidade")

  // 4. informações de saúde
  gestante               Boolean @default(false)
  medicamentoContinuo    Boolean @default(false) @map("medicamento_continuo")
  medicamentoQual        String? @map("medicamento_qual")
  produtoAcne            Boolean @default(false) @map("produto_acne")
  produtoAcneQual        String? @map("produto_acne_qual")
  procedimentoEstetico   Boolean @default(false) @map("procedimento_estetico")
  procedimentoQualQuando String? @map("procedimento_qual_quando")
  alergiaConhecida       Boolean @default(false) @map("alergia_conhecida")
  alergiaConhecidaQual   String? @map("alergia_conhecida_qual")

  // 5. histórico de depilação
  jaDepilou      Boolean           @default(false) @map("ja_depilou")
  metodos        MetodoDepilacao[]
  laserDetalhe   String?           @map("laser_detalhe")
  reacaoAnterior Boolean           @default(false) @map("reacao_anterior")
  reacaoQual     String?           @map("reacao_qual")

  // 6. preferências e observações
  preferencias String?

  observacoesTerapeuta String? @map("observacoes_terapeuta")

  paciente    Paciente   @relation(fields: [pacienteId], references: [id])
  revisadaPor Terapeuta? @relation("DepilacaoRevisora", fields: [revisadaPorId], references: [id])

  @@index([status, enviadaEm])
  @@index([pacienteId])
  @@map("fichas_depilacao")
}
