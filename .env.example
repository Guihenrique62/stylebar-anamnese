# URL pública da aplicação (usada para montar os links enviados às clientes)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Banco de dados PostgreSQL (Neon, Supabase ou local)
DATABASE_URL=postgresql://user:password@localhost:5432/stylebar_anamnese

# Segredo para assinar o cookie de sessão das terapeutas (mínimo 32 caracteres)
SESSION_SECRET=troque-por-uma-string-aleatoria-com-32-ou-mais-caracteres
