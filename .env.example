# URL pública da aplicação. Opcional na Vercel (usa a URL do projeto). O https:// pode ser omitido.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Postgres. Substitua [YOUR-PASSWORD] pela senha do banco (Dashboard > Project Settings > Database).
# Pooler em modo transação (IPv4), usado pela aplicação:
DATABASE_URL="postgresql://postgres.tnhmwtnydexwhmdswveu:[YOUR-PASSWORD]@aws-0-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Pooler em modo sessão, usado pelas migrações do Prisma:
DIRECT_URL="postgresql://postgres.tnhmwtnydexwhmdswveu:[YOUR-PASSWORD]@aws-0-us-east-2.pooler.supabase.com:5432/postgres"

# Supabase Auth (Dashboard > Project Settings > API Keys). Use a chave "publishable", nunca a secret/service_role.
# Estas duas são públicas por design (vão para o navegador): na Vercel, cadastre como Plaintext, não como Sensitive.
NEXT_PUBLIC_SUPABASE_URL=https://tnhmwtnydexwhmdswveu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
